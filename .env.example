# Discord bot
MAI_BOT_TOKEN=
CLIENT_ID=
GUILD_ID=

# maimai DX NET (international) account used by the bot
MAI_USER=
MAI_PASS=

# Optional: song database cache lifetime in seconds (default 21600 = 6 hours)
# SONGS_CACHE_TTL=21600

# otogo_worker.py (OtoGO website): in-game name of the bot account, shown to users who must accept its friend request
OTOGO_BOT_NAME=
# Optional: path to the Firebase service account key (default ./firebase-key.json)
# FIREBASE_KEY=/home/ubuntu/mai-bot/firebase-key.json
